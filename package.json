{
  "name": "vscode-extension-md-translator",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.5",
  "publisher": "sunven",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunven/vscode-extension-md-translator"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "translation",
    "openai",
    "vscode",
    "llm"
  ],
  "activationEvents": [
    "onCommand:mdTranslator.translateMarkdownToChinese",
    "onCommand:mdTranslator.setApiKey",
    "onCommand:mdTranslator.clearApiKey"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mdTranslator.translateMarkdownToChinese",
        "title": "%command.translateMarkdownToChinese.title%",
        "icon": "$(globe)"
      },
      {
        "command": "mdTranslator.setApiKey",
        "title": "%command.setApiKey.title%",
        "icon": "$(key)"
      },
      {
        "command": "mdTranslator.clearApiKey",
        "title": "%command.clearApiKey.title%",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "mdTranslator.apiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "%configuration.apiBaseUrl.description%"
        },
        "mdTranslator.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "%configuration.model.description%"
        },
        "mdTranslator.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "%configuration.temperature.description%"
        },
        "mdTranslator.maxChunkChars": {
          "type": "number",
          "default": 6000,
          "minimum": 1000,
          "maximum": 20000,
          "description": "%configuration.maxChunkChars.description%"
        },
        "mdTranslator.maxResponseTokens": {
          "type": "number",
          "default": 4000,
          "minimum": 256,
          "maximum": 64000,
          "description": "%configuration.maxResponseTokens.description%"
        },
        "mdTranslator.targetLanguage": {
          "type": "string",
          "default": "Simplified Chinese",
          "description": "%configuration.targetLanguage.description%"
        },
        "mdTranslator.requestTimeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 5000,
          "maximum": 300000,
          "description": "%configuration.requestTimeoutMs.description%"
        },
        "mdTranslator.useJsonResponseFormat": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.useJsonResponseFormat.description%"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "mdTranslator.translateMarkdownToChinese",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && vscode-test",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~20.19.40",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^4.9.4"
  }
}
